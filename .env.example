# ── OpenAI / LLM ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_MODEL=your-model-name
OPENAI_FALLBACK_MODEL=your-model-name
OPENAI_VISION_MODEL=your-model-name
OPENAI_TIMEOUT_SECONDS=60

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_BASE_URL=http://ocr-service:18083
OCR_MODEL=paddle
OCR_TIMEOUT_SECONDS=120

# ── Image Generation ──────────────────────────────────────────────────────────
IMAGE_API_KEY=your-image-api-key
IMAGE_API_BASE_URL=https://your-image-endpoint/v1
IMAGE_MODEL=your-image-model

# ── LangSmith Tracing ─────────────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=market-agent

# ── Vercel (report deployment) ────────────────────────────────────────────────
VERCEL_TOKEN=your-vercel-token
VERCEL_PROJECT_DIR=outputs/dingtalk_reports
VERCEL_SCOPE=your-vercel-scope

# ── DingTalk ──────────────────────────────────────────────────────────────────
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret
DINGTALK_REPORT_PUBLIC_BASE_URL=
DINGTALK_STREAM_MAX_WORKERS=4
DINGTALK_IMAGE_DIR=outputs/dingtalk_incoming_images

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
